{
  "name": "bzxz",
  "version": "1.0.0",
  "description": "多源标准检索与批量下载",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src/api src/shared",
    "test:dev": "vitest src/api src/shared",
    "test:live": "vitest run src/sources",
    "test:all": "vitest run",
    "electron:dev": "tsc -p tsconfig.electron.json && electron .",
    "electron:build": "tsc -p tsconfig.electron.json && electron-builder --win portable",
    "electron:build:nsis": "tsc -p tsconfig.electron.json && electron-builder --win nsis",
    "electron:build:all": "tsc -p tsconfig.electron.json && electron-builder --win --publish never",
    "electron:dist": "tsc -p tsconfig.electron.json && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.bzxz.app",
    "productName": "标准盒子",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "scripts/ocr_ddddocr.py",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "scripts/ocr_ddddocr.py",
        "to": "scripts/ocr_ddddocr.py"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "标准盒子",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node